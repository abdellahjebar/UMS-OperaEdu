{
  "ConnectionStrings": {
    "MasterConnection": "Server=localhost;Database=UMS_Master;Trusted_Connection=True;TrustServerCertificate=True;",
    "TenantTemplate": "Server=localhost;Database=UMS_Tenant_{0};Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyForJWTTokenGenerationThatIsAtLeast32CharactersLong",
    "Issuer": "UMS.API",
    "Audience": "UMS.Client",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*"
}